# prlearn local environment template.
# Copy values into your shell, a private env file outside git, or your scheduler.
# Do not commit real tokens, private keys, chat IDs, passphrases, or local paths.

# GitHub App auth is recommended for stable daily sync.
PRLEARN_GITHUB_APP_ID=
PRLEARN_GITHUB_INSTALLATION_ID=
PRLEARN_GITHUB_APP_PRIVATE_KEY_FILE=
PRLEARN_GITHUB_AUTHOR=

# Optional direct private-key env fallback. Prefer PRLEARN_GITHUB_APP_PRIVATE_KEY_FILE.
PRLEARN_GITHUB_APP_PRIVATE_KEY=

# Optional GitHub API base for GitHub Enterprise Server.
PRLEARN_GITHUB_API_URL=https://api.github.com

# Optional raw-payload encryption for local SQLite storage.
PRLEARN_PASSPHRASE=

# Optional Telegram review bot.
PRLEARN_TELEGRAM_BOT_TOKEN=
PRLEARN_TELEGRAM_CHAT_ID=

# Optional direct OpenAI API engine. Codex OAuth does not use this.
OPENAI_API_KEY=

# Optional Codex engine overrides. Defaults are gpt-5.5 and low reasoning.
PRLEARN_CODEX_MODEL=
PRLEARN_CODEX_REASONING_EFFORT=

# Optional Ollama override. Defaults require localhost.
PRLEARN_OLLAMA_BASE_URL=http://127.0.0.1:11434
